{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gika",
  "version": "1.0.0",
  "identifier": "com.gika.dev",
  "build": {
    "beforeDevCommand": "pnpm vite dev",
    "devUrl": "http://127.0.0.1:14200",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "gika",
        "width": 1200,
        "height": 800,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
